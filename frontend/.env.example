# ---------------------------------------------------------------------------
# GoldLens frontend env — copy to frontend/.env (git-ignored)
# Root-level .env.example also documents backend vars (GOLDLENS_*).
# ---------------------------------------------------------------------------

# Data mode: fixture (default) | live. Fixture serves the bundled one-day
# diagnostic sample, permanently labeled in the UI ("Fixture mode — bundled
# diagnostic sample"). Live calls the backend for real and renders errors
# as errors — never falls back to fixture data silently.
VITE_DATA_MODE=fixture

# Live mode only. Base URL including route prefix; PROPOSED default per
# docs/API_CONTRACT.md v1 (routes still pending backend delivery).
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Report family the app opens on. The bundled fixture only has GOLDM data;
# other families return the data_quality_rejected error contract.
VITE_DEFAULT_SYMBOL=GOLDM

# Simulated latency for fixture loads (ms) — demo realism, no fake data.
VITE_FIXTURE_DELAY_MS=250
