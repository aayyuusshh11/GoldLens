# GoldLens integration environment (backend side).
# Copy to .env inside backend/ (never commit the real .env).

# --- Quant wiring (Phase 5 seam) ---
# Points the backend at the quant team's service adapter. The adapter is the
# package `quant.service_adapter` at the REPO ROOT (one level above backend/),
# so run uvicorn with the parent on PYTHONPATH, e.g. from backend/:
#   set PYTHONPATH=..
#   set GOLDLENS_QUANT_PACKAGE=quant.service_adapter
#   python -m uvicorn app.main:app --port 8000
# When unset or not importable, the API stays honest: signals/backtests
# return the documented NO_TRADE / runnable:false outcomes (nothing wired).
GOLDLENS_QUANT_PACKAGE=quant.service_adapter

# --- Data locations ---
# Defaults already resolve to <repo>/data; override only for alternate layouts.
# GOLDLENS_DATA_DIR=..
# GOLDLENS_DB_FILENAME=goldlens.duckdb
# GOLDLENS_CSV_PATH=<absolute path to a BhavCopyDateWise_*.csv>
