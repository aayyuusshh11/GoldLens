# ---------------------------------------------------------------------------
# GoldLens root env — copy to .env (git-ignored).
# Backend vars feed backend/app/config.py; frontend vars feed Vite builds
# (frontend/.env is frontend-specific; see frontend/.env.example).
# ---------------------------------------------------------------------------

# --- Backend data locations (defaults resolve to <repo>/data) ---------------
# GOLDLENS_DATA_DIR=../data
# GOLDLENS_DB_FILENAME=goldlens.duckdb
# GOLDLENS_CSV_PATH=<path to a BhavCopyDateWise_*.csv>

# --- Quant service wiring (Phase 5 seam) ------------------------------------
# See backend/.env.example for the full explanation. When unset, the backend
# stays honest: signals return NO_TRADE and backtests return runnable:false.
# GOLDLENS_QUANT_PACKAGE=quant.service_adapter

# --- Frontend (Vite build-time; put these in frontend/.env) -----------------
# fixture (default) = bundled 1-trading-day mirror, labeled in the UI.
# live              = real backend; unset VITE_API_BASE_URL uses the Vite dev
#                     proxy (/api → 127.0.0.1:8000). No silent fixture fallback.
#VITE_DATA_MODE=fixture
#VITE_API_BASE_URL=http://localhost:8000
#VITE_DEFAULT_SYMBOL=GOLDM
#VITE_FIXTURE_DELAY_MS=250
