# ---------------------------------------------------------------------------
# GoldLens frontend env — copy to frontend/.env (git-ignored)
# Root-level .env.example also documents backend vars (GOLDLENS_*).
# ---------------------------------------------------------------------------

# Data mode: fixture (default) | live.
#  - fixture: bundled mirror of the real backend's 1-trading-day responses,
#    permanently labeled in the UI. Never presented as live output.
#  - live: calls the FastAPI backend for real. Errors render as errors — the
#    app NEVER silently falls back to fixture data.
VITE_DATA_MODE=fixture

# Live mode only. Leave UNSET for zero-config local development:
# requests go same-origin through the Vite dev proxy (/api → 127.0.0.1:8000,
# see vite.config.ts). Or point at an explicit deployment, base only, no
# trailing slash:
#VITE_API_BASE_URL=http://localhost:8000

# Preferred contract family at boot. Symbols are an OPEN set driven by the
# ingested data (GET /api/pairs + /api/contracts); with one day of data the
# fixture dataset holds GOLDM and GOLD rows.
VITE_DEFAULT_SYMBOL=GOLDM

# Simulated latency for fixture loads (ms) — demo realism, no fake data.
VITE_FIXTURE_DELAY_MS=250
