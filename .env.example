# ---------------------------------------------------------------------------
# BACKEND (quant boundary / API) — prefixes: GOLDLENS_* / generic server vars
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
GOLDLENS_DATA_DIR=../data
GOLDLENS_DATABASE_PATH=../data/goldlens.duckdb

# ---------------------------------------------------------------------------
# FRONTEND (Vite build-time) — prefixes: VITE_*  — frontend/.env
# Copy frontend/.env.example → frontend/.env for the frontend-specific config.
# These defaults make the app run in fixture mode on the bundled diagnostic
# sample until the backend HTTP routes ship (see docs/INTEGRATION_BLOCKERS.md).
# ---------------------------------------------------------------------------
# fixture (default) = bundled one-day sample, always labeled in the UI.
# live              = real backend calls; requires VITE_API_BASE_URL (no silent
#                     fallback to fixtures — failures render as error states).
#VITE_DATA_MODE=fixture
#VITE_API_BASE_URL=http://localhost:8000/api/v1
#VITE_DEFAULT_SYMBOL=GOLDM
#VITE_FIXTURE_DELAY_MS=250
